# Defaults NÃO sensíveis. Senhas e chaves NÃO têm default: vêm de .env.local (dev),
# GitHub Secrets (CI) ou GCP Secret Manager (prod). Ver specs/014 e ADR 0015.
COMPOSE_PROJECT_NAME=leilao
TZ=UTC

# Postgres (database/postgres/docker-compose.yml)
POSTGRES_IMAGE=postgres:18.6-alpine
POSTGRES_PORT=15432
POSTGRES_DB=leilao
POSTGRES_USER=leilao
POSTGRES_CPUS=1
POSTGRES_MEM=300m
POSTGRES_NOFILE=4096
POSTGRES_PIDS=200

# Redis (cache/redis/docker-compose.yml)
REDIS_IMAGE=redis:8.8.3-alpine
REDIS_PORT=16379
REDIS_CPUS=0.5
REDIS_MEM=64m
REDIS_MAXMEMORY=48mb
REDIS_NOFILE=4096
REDIS_PIDS=64

# API (apps/api)
API_PORT=13000
API_CPUS=1
API_MEM=300m
API_NOFILE=8192
SCRYFALL_USER_AGENT=LeilaoVerzel/0.1
WEB_ORIGIN=http://localhost:15173

# Web (apps/web, dev)
WEB_PORT=15173
