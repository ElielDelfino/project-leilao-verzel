# Defaults NÃO sensíveis. Senhas e chaves NÃO têm default: vêm de .env.local (dev),
# GitHub Secrets (CI) ou GCP Secret Manager (prod). Ver specs/014 e ADR 0015.
COMPOSE_PROJECT_NAME=leilao
TZ=UTC

# Postgres (database/postgres/docker-compose.yml; prod: infra/docker-compose.prod.yml)
POSTGRES_IMAGE=postgres:18.6-alpine
# Conexão da API em dev (no compose de prod a API usa postgres:5432 pela rede interna)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_DB=leilao
POSTGRES_USER=leilao
POSTGRES_CPUS=1
POSTGRES_MEM=300m
POSTGRES_NOFILE=4096
POSTGRES_PIDS=200
# RAM + swap do contêiner (só no compose de prod; swap 2× só para Postgres e API: ADR 0013 e 0024)
POSTGRES_MEMSWAP=600m

# Redis (cache/redis/docker-compose.yml; prod: infra/docker-compose.prod.yml)
REDIS_IMAGE=redis:8.8.3-alpine
# Conexão da API em dev (no compose de prod a API usa redis:6379 pela rede interna)
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_CPUS=0.5
REDIS_MEM=64m
REDIS_MAXMEMORY=48mb
REDIS_NOFILE=4096
REDIS_PIDS=64
REDIS_MEMSWAP=64m

# API (apps/api; imagem: apps/api/Dockerfile)
API_PORT=13000
API_CPUS=1
API_MEM=300m
API_NOFILE=8192
API_PIDS=128
API_MEMSWAP=600m
SCRYFALL_USER_AGENT=LeilaoVerzel/0.1
WEB_ORIGIN=http://localhost:15173

# Web (apps/web, dev)
WEB_PORT=15173

# Caddy de produção (apps/web/Dockerfile, infra/caddy/Caddyfile, infra/docker-compose.prod.yml)
# Prod: CADDY_SITE_ADDRESS=<ip-com-hifens>.sslip.io (ADR 0020), definido no deploy.
CADDY_SITE_ADDRESS=localhost
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
CADDY_CPUS=0.5
# 64 MB sem swap e GOMEMLIMIT ~75% do limite (ADR 0024)
CADDY_MEM=64m
CADDY_MEMSWAP=64m
CADDY_GOMEMLIMIT=48MiB
CADDY_NOFILE=8192
CADDY_PIDS=64
