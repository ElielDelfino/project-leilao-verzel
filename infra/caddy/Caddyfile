# Caddy de produção (specs/014 §Produção, ADR 0013 e 0020). Embutido na imagem da web
# (apps/web/Dockerfile), junto com a SPA buildada em /srv.
# Variáveis lidas no início (placeholders {$VAR}, avaliados ao carregar o arquivo):
#   CADDY_SITE_ADDRESS  host público (prod: <ip-com-hifens>.sslip.io; padrão localhost, com a CA local)
#   API_PORT            porta da API na rede interna do compose (padrão 13000)
{
	# Sem API de administração: nada na rede do contêiner reconfigura o Caddy. Trocar a config
	# exige reiniciar o contêiner (o deploy já recria os serviços).
	admin off
	persist_config off
	# Com localhost o Caddy emite pela CA local; não tenta instalar a raiz no trust store.
	skip_install_trust
	servers {
		# Sem HTTP/3: o firewall da VM libera só 80 e 443 TCP (specs/014), e o compose não publica 443/udp.
		protocols h1 h2
		# Cabeçalhos em até 10 s (slowloris) e conexão keep-alive ociosa por até 2 min.
		# Sem read_body: ele vira o ReadTimeout do Go, cujo prazo continua valendo na conexão
		# sequestrada pelo upgrade ("The returned net.Conn may have read or write deadlines already
		# set", doc de http.Hijacker) e derrubaria o WebSocket do Socket.IO. O tamanho do corpo
		# é limitado pelo request_body abaixo.
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

{$CADDY_SITE_ADDRESS:localhost} {
	# gzip e não zstd: o limite do contêiner é 32 MB (specs/014).
	encode gzip

	# Headers de segurança em todas as respostas (SPA e proxy). A SPA não tem script nem estilo
	# inline (/tema-inicial.js é externo), então script-src 'self' basta, sem nonce.
	# connect-src 'self' cobre o fetch de /api e o WebSocket do Socket.IO na mesma origem.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# A SPA não usa câmera, microfone, localização, pagamento nem USB.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}

	# REST e Socket.IO vão para a API; o reverse_proxy do Caddy repassa o upgrade de WebSocket.
	# Corpo de até 1 MB: a API só recebe JSON pequeno (sem upload); acima disso, 413 do Caddy.
	handle /api/* {
		request_body {
			max_size 1MB
		}
		reverse_proxy api:{$API_PORT:13000}
	}

	handle /socket.io/* {
		request_body {
			max_size 1MB
		}
		reverse_proxy api:{$API_PORT:13000}
	}

	# Assets do Vite (nome com hash): cache longo e sem fallback. Um asset ausente responde 404,
	# e o cache imutável só vai nas respostas 200.
	handle /assets/* {
		root * /srv
		header {
			Cache-Control "public, max-age=31536000, immutable"
			match status 200
		}
		file_server
	}

	# SPA: arquivo existente ou fallback para index.html (rotas do React Router). Revalida a cada
	# acesso, para um deploy novo não deixar o navegador com um index.html que aponta para assets
	# apagados.
	handle {
		root * /srv
		header ?Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Healthcheck do contêiner: só no loopback, fora da porta pública e sem TLS.
http://127.0.0.1:2020 {
	bind 127.0.0.1
	respond /saude 200
}
