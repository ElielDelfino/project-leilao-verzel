# Valores de produção NÃO sensíveis (specs/014 §Produção, ADR 0033 item 8). Versionado e sem
# nenhum dos 6 segredos: eles ficam em /opt/leilao/.env.local na VPS, que nunca é passado ao
# Compose (ADR 0033, item 4.4). Lido DEPOIS do .env da raiz, cujos defaults de dev ele sobrescreve:
#   docker compose -p leilao-prod --env-file .env --env-file infra/prod.env \
#       -f infra/docker-compose.prod.yml <comando>
# Os limites de CPU não mudam e vêm do .env (Postgres 1, API 1, Redis 0,5, Caddy 0,5).

# Host público (ADR 0033, item 2). O Caddy emite o certificado do Let's Encrypt para ele; a API
# usa https://<host> como WEB_ORIGIN.
CADDY_SITE_ADDRESS=teste-verzel.duckdns.org

# Arquivos de segredo gravados por infra/deploy/materializar-segredos.sh (tmpfs, specs/014 §Segredos)
LEILAO_SECRETS_DIR=/run/leilao/secrets

# Limites de memória para os 4 GB da VPS (ADR 0033, item 8). Soma: 2 GB de RAM.
# Swap de 2× o limite só para Postgres e API (ADR 0024, item 2); Redis e Caddy sem swap.
POSTGRES_MEM=1g
POSTGRES_MEMSWAP=2g

# A heap do Node (--max-old-space-size=576, 75% do limite) está no environment: da API.
API_MEM=768m
API_MEMSWAP=1536m

REDIS_MEM=128m
REDIS_MEMSWAP=128m
REDIS_MAXMEMORY=96mb

# GOMEMLIMIT em 75% do limite do contêiner
CADDY_MEM=128m
CADDY_MEMSWAP=128m
CADDY_GOMEMLIMIT=96MiB
