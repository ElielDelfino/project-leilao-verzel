{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Build de produção (nest build): só src/, emitido em dist/ (dist/main.js). O typecheck usa o
  // tsconfig.json, que também cobre test/.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": ["src/**/*.ts"]
}
