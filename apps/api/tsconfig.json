{
  "$schema": "https://json.schemastore.org/tsconfig",
  // API NestJS 12 (ESM, ADR 0011/0012). Typecheck (--noEmit) cobre src/ e test/; o build usa o
  // tsconfig.build.json, que emite só src/ em dist/ (dist/main.js).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "./dist"
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
