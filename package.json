{
  "name": "leilao-verzel",
  "version": "0.0.0",
  "private": true,
  "description": "Casa de Leilões online de cartas Magic: The Gathering (teste técnico Elite Dev Verzel)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.7 <25",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel --if-present run dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "contracts:gen": "node scripts/contracts-gen.mjs",
    "contracts:check": "node scripts/contracts-gen.mjs --check",
    "contracts:lint": "node scripts/contracts-lint.mjs",
    "verify:quick": "node scripts/verify.mjs quick",
    "verify:full": "node scripts/verify.mjs full",
    "db:generate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs generate --config apps/api/drizzle.config.ts",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import ./apps/api/src/db/resolver-ts.mjs apps/api/src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import ./apps/api/src/db/resolver-ts.mjs apps/api/src/db/seed.ts",
    "db:sync-password": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/db-sync-password.mjs",
    "infra:up": "docker compose --env-file .env --env-file .env.local up -d",
    "keys:generate": "node scripts/keys-generate.mjs",
    "test:scripts": "node --test \"scripts/*.test.mjs\""
  },
  "devDependencies": {
    "@asyncapi/parser": "3.6.6",
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@noble/ed25519": "3.2.0",
    "@playwright/test": "1.64.1",
    "@redocly/cli": "2.71.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.3.0",
    "globals": "17.13.0",
    "lefthook": "2.2.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.0",
    "yaml": "2.9.1"
  }
}
