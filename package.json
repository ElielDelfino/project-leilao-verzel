{
  "name": "leilao-verzel",
  "version": "0.0.0",
  "private": true,
  "description": "Casa de Leilões online de cartas Magic: The Gathering (teste técnico Elite Dev Verzel)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel --if-present run dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "verify:quick": "node -e \"console.error('verify:quick ainda não existe (tarefa 011)');process.exit(1)\"",
    "verify:full": "node -e \"console.error('verify:full ainda não existe (tarefa 011)');process.exit(1)\"",
    "db:generate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs generate --config apps/api/drizzle.config.ts",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import ./apps/api/src/db/resolver-ts.mjs apps/api/src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import ./apps/api/src/db/resolver-ts.mjs apps/api/src/db/seed.ts",
    "infra:up": "docker compose --env-file .env --env-file .env.local up -d",
    "keys:generate": "node scripts/keys-generate.mjs",
    "test:scripts": "node --test \"scripts/*.test.mjs\""
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@noble/ed25519": "3.2.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.3.0",
    "globals": "17.13.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
